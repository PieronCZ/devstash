# Neon PostgreSQL — use the DEVELOPMENT branch connection string here.
# The production branch URL is configured in the deployment environment.
# Get this from the Neon dashboard (use the pooled connection string).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Context7 MCP API key — referenced as ${CONTEXT7_API_KEY} in .mcp.json.
# Get one from https://context7.com/dashboard
CONTEXT7_API_KEY="ctx7sk-..."

# Canonical, public origin of this deployment (no trailing slash). Used as the
# single source of truth for absolute links in verification/password-reset
# emails. Must NOT be derived from request headers (Host-header/link poisoning).
# Defaults to http://localhost:3000 when unset.
APP_URL="http://localhost:3000"

# Toggle the email-verification system (credentials sign-up).
# Enabled by default; set to false/0/off/no to disable — accounts then register
# pre-verified with no Resend email. Disable while Resend has no verified domain
# (it can only deliver to its own account owner).
EMAIL_VERIFICATION_ENABLED=true

# Upstash Redis — backs auth rate limiting (login, register, forgot/reset
# password, resend verification). Create a database at https://console.upstash.com
# and copy its REST URL + token. When BOTH are unset the rate limiter FAILS OPEN
# (all requests allowed), so local dev works without an Upstash project.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Toggle auth rate limiting. Unset = ON in production only — local dev has no
# real client IP (all requests bucket under "unknown" and share one limit), so
# limiting is disabled in dev by default. Set true/1/on/yes to force it on
# locally (to test limits), or false/0/off/no to force it off everywhere.
RATE_LIMIT_ENABLED=

# Cloudflare R2 — file & image uploads (Pro file/image item types). R2 is
# S3-compatible; we drive it with the AWS S3 client. Create a bucket + an R2 API
# token (Object Read & Write) at https://dash.cloudflare.com → R2.
#   - R2_ACCOUNT_ID:        Cloudflare account id (shown on the R2 overview page).
#   - R2_ACCESS_KEY_ID /    the R2 API token's access key id + secret.
#     R2_SECRET_ACCESS_KEY
#   - R2_BUCKET_NAME:       the bucket uploads are stored in.
#   - R2_PUBLIC_URL:        the bucket's public base URL (r2.dev or a custom
#                           domain), no trailing slash — images preview from it;
#                           downloads/deletes recover the object key from it.
#   - S3_API_ENDPOINT:      the S3 API endpoint,
#                           https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
S3_API_ENDPOINT=