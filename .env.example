# Neon PostgreSQL — use the DEVELOPMENT branch connection string here.
# The production branch URL is configured in the deployment environment.
# Get this from the Neon dashboard (use the pooled connection string).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Context7 MCP API key — referenced as ${CONTEXT7_API_KEY} in .mcp.json.
# Get one from https://context7.com/dashboard
CONTEXT7_API_KEY="ctx7sk-..."

# Toggle the email-verification system (credentials sign-up).
# Enabled by default; set to false/0/off/no to disable — accounts then register
# pre-verified with no Resend email. Disable while Resend has no verified domain
# (it can only deliver to its own account owner).
EMAIL_VERIFICATION_ENABLED=true
